{
  "name": "pdfno",
  "version": "0.1.0",
  "private": true,
  "description": "Mac-first language-learning reader foundation; licensed-engine integration pending",
  "license": "AGPL-3.0-or-later",
  "author": "PDFno contributors",
  "main": "electron/main.mjs",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "start": "electron .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "test:e2e": "playwright test",
    "native:build": "xcodebuild -workspace native/PDFno.xcworkspace -scheme PDFnoBridge -destination generic/platform=macOS -configuration Release -derivedDataPath native/build CODE_SIGNING_ALLOWED=NO build",
    "native:check": "node scripts/check-native.mjs",
    "notices": "node scripts/notices.mjs",
    "format": "prettier --write src electron shared scripts tests *.ts *.mjs *.json index.html",
    "check:source": "node scripts/check-source.mjs",
    "electron:install": "install-electron"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
