// QA snapshot only. The production App entry is not modified.
import SwiftUI
import AppKit
import Darwin
import PDFnoUI

@main struct PDFnoMacApp: App {
    init() {
        let expected = "org.pdfno.integration.professionala20261007.PDFnoMac"
        guard Bundle.main.bundleIdentifier == expected else { exit(2) }
        let env = ProcessInfo.processInfo.environment
        guard let uuid = UUID(uuidString: env["PDFNO_UI_TEST_SESSION"] ?? "__PREVIEW_UUID__") else { exit(2) }
        let session = uuid.uuidString, scope = env["PDFNO_A_QA_SCOPE"] ?? "preview"
        guard ["preview", "a-regression", "full64"].contains(scope) else { exit(2) }
        setenv("PDFNO_UI_TEST_SESSION", session, 1)
        setenv("PDFNO_UI_TEST_DEEPSEEK", "offline", 1)
        setenv("PDFNO_A_QA_AUTOSAMPLE", scope == "preview" ? "1" : "0", 1)
        do {
            let manager = FileManager.default
            let registry = URL(fileURLWithPath: "__REGISTRY_ROOT__", isDirectory: true)
            try manager.createDirectory(at: registry, withIntermediateDirectories: true, attributes: [.posixPermissions: 0o700])
            let root = URL(fileURLWithPath: "/tmp", isDirectory: true).appendingPathComponent("PDFno-UITests-" + session)
            let marker = registry.appendingPathComponent("session-" + session + ".json")
            if manager.fileExists(atPath: root.path) {
                let attributes = try manager.attributesOfItem(atPath: root.path)
                guard attributes[.type] as? FileAttributeType == .typeDirectory,
                      (attributes[.posixPermissions] as? NSNumber)?.intValue == 0o700,
                      (attributes[.ownerAccountID] as? NSNumber)?.uint32Value == getuid(),
                      let stored = try JSONSerialization.jsonObject(with: Data(contentsOf: marker)) as? [String: String],
                      stored["bundle"] == expected, stored["session"] == session else { exit(2) }
            } else {
                try manager.createDirectory(at: root, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
                try JSONSerialization.data(withJSONObject: ["bundle": expected, "session": session], options: [.sortedKeys]).write(to: marker, options: .atomic)
            }
            let record: [String: Any] = ["pid": ProcessInfo.processInfo.processIdentifier, "bundle": expected, "session": session, "scope": scope, "root": root.path, "offline": true]
            try JSONSerialization.data(withJSONObject: record, options: [.sortedKeys]).write(to: registry.appendingPathComponent("process-\(ProcessInfo.processInfo.processIdentifier)-\(session).json"), options: .atomic)
        } catch { exit(2) }
    }
    private var width: CGFloat { CGFloat(Double(ProcessInfo.processInfo.environment["PDFNO_A_QA_WIDTH"] ?? "1280") ?? 1280) }
    private var height: CGFloat { CGFloat(Double(ProcessInfo.processInfo.environment["PDFNO_A_QA_HEIGHT"] ?? "800") ?? 800) }
    private var appearance: ColorScheme? {
        switch ProcessInfo.processInfo.environment["PDFNO_A_QA_APPEARANCE"] {
        case "dark": .dark
        case "light": .light
        default: nil
        }
    }
    var body: some Scene {
        WindowGroup("PDFno A · Isolated original-fixture QA", id: "library") {
            LibraryWorkspace().frame(minWidth: 720, minHeight: 520).preferredColorScheme(appearance)
        }.defaultSize(width: width, height: height).defaultPosition(.center)
            .commands { CommandGroup(replacing: .newItem) {} }
    }
}
