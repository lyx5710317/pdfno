    // QA snapshot only. These controls and clipboard writes belong to the
    // original synthetic fixture; the user's input source is never changed.
    @MainActor private func pasteOriginalFixture(_ original: String, into field: XCUIElement) throws {
        let board = NSPasteboard.general
        board.clearContents()
        guard board.setString(original, forType: .string) else {
            throw NSError(domain: "OriginalFixturePaste", code: 1)
        }
        field.typeKey("a", modifierFlags: .command)
        field.typeKey("v", modifierFlags: .command)
        let exact = expectation(for: NSPredicate { _, _ in
            field.exists && field.value as? String == original
        }, evaluatedWith: field)
        wait(for: [exact], timeout: 12)
        XCTAssertEqual(field.value as? String, original, "The actual native editor must contain the complete original fixture before saving")
        guard field.value as? String == original else {
            throw NSError(domain: "OriginalFixturePaste", code: 2)
        }
        print("PDFNO_ORIGINAL_FIXTURE_INPUT identifier=\(field.identifier) exact=true utf16=\(original.utf16.count)")
    }

    @MainActor private func physicalFileControl(
        _ app: XCUIApplication, role: XCUIElement.ElementType,
        identifier: String, labels: [String]
    ) throws -> XCUIElement {
        var result: XCUIElement?
        let ready = expectation(for: NSPredicate { _, _ in
            // Only observed physical file controls with stable native IDs.
            let owned = app.windows.allElementsBoundByAccessibilityElement + app.sheets.allElementsBoundByAccessibilityElement
            let windows = owned.filter {
                $0.exists && !$0.frame.isEmpty && !$0.frame.isNull && !$0.frame.isInfinite
                && $0.frame.minX.isFinite && $0.frame.minY.isFinite
            }
            for window in windows {
                let query = window.descendants(matching: role)
                let named = identifier.isEmpty ? labels : [identifier] + labels
                let candidates = named.flatMap { query.matching(identifier: $0).allElementsBoundByAccessibilityElement }
                for control in candidates {
                    guard control.exists else { continue }
                    guard control.isEnabled && control.isHittable else { continue }
                    let frame = control.frame
                    guard !frame.isEmpty && !frame.isNull && !frame.isInfinite,
                          frame.minX.isFinite && frame.minY.isFinite,
                          !window.frame.intersection(frame).isEmpty else { continue }
                    result = control
                    break
                }
                if result != nil { break }
            }
            return result != nil
        }, evaluatedWith: app)
        wait(for: [ready], timeout: 12)
        let control = try XCTUnwrap(result, "The real owned file-panel control must be visible inside an application window")
        XCTAssertEqual(control.elementType, role)
        print("PDFNO_PHYSICAL_FILE_CONTROL role=\(role.rawValue) id=\(control.identifier) label=\(control.label) frame=\(control.frame)")
        return control
    }

    @MainActor private func originalNativeGapStart(_ app: XCUIApplication, window: XCUIElement, add: XCUIElement, more: XCUIElement) throws -> XCUICoordinate {
        // QA-only accessibility ownership names the actual native band. It
        // changes no drawing, hit testing, mouse handling or drag destination.
        let band = app.descendants(matching: .any).matching(identifier: "qa-document-titlebar-band").firstMatch
        XCTAssertTrue(band.waitForExistence(timeout: 10))
        let frame = band.frame, desired = CGPoint(x: (add.frame.maxX + more.frame.minX)/2,y: add.frame.midY)
        XCTAssertTrue(!frame.isEmpty && !frame.isNull && !frame.isInfinite && frame.contains(desired))
        guard !frame.isEmpty && frame.contains(desired) else { throw NSError(domain: "OriginalNativeGap",code: 1) }
        let start = band.coordinate(withNormalizedOffset: CGVector(dx: (desired.x-frame.minX)/frame.width,dy: (desired.y-frame.minY)/frame.height))
        let resolved = start.screenPoint
        XCTAssertEqual(resolved.x, desired.x, accuracy: 0.5)
        XCTAssertEqual(resolved.y, desired.y, accuracy: 0.5)
        XCTAssertTrue(window.frame.contains(resolved))
        print("PDFNO_GAP_RESOLUTION band=\(frame) desired=\(desired) resolved=\(resolved)")
        return start
    }
    @MainActor private func reportNativeGap(_ app: XCUIApplication, original: CGRect, add: XCUIElement, more: XCUIElement) throws {
        let token = try XCTUnwrap(app.launchEnvironment["PDFNO_UI_TEST_SESSION"])
        XCTAssertNotNil(UUID(uuidString: token))
        print("PDFNO_GAP_DRIVER window=\(original) add=\(add.frame) more=\(more.frame) intendedScreen=\((add.frame.maxX + more.frame.minX) / 2),\(add.frame.midY)")
        let root = URL(fileURLWithPath: "__DIAGNOSTICS_ROOT__/" + token)
        for phase in ["layout", "hit-any", "hit-empty", "mouse-down", "after-drag", "event-1", "event-2", "event-6"] {
            let path = root.appendingPathComponent("qa-titlebar-" + phase + ".json")
            if let bytes = try? Data(contentsOf: path), bytes.count < 8192 {
                print("PDFNO_NATIVE_GAP_AUDIT " + String(decoding: bytes, as: UTF8.self))
            } else { print("PDFNO_NATIVE_GAP_AUDIT missing=" + phase) }
        }
    }

    @MainActor private func confirmOriginalFixtureLocation(_ app: XCUIApplication, path: String) throws {
        // QA09's actual native hierarchy contains a full-path completion row
        // inside GoToWindow. Its Go button belongs only to a TouchBar branch.
        // Double-click this one observed physical row, as a normal native
        // table action. No synthetic Go button, keyboard fallback or retry.
        let sheet = app.sheets.matching(identifier: "GoToWindow").firstMatch
        var completion: XCUIElement?
        let ready = expectation(for: NSPredicate { _, _ in
            guard sheet.exists else { return false }
            let bounds = sheet.frame
            guard !bounds.isEmpty && !bounds.isNull && !bounds.isInfinite else { return false }
            let rows = sheet.tables.tableRows.containing(NSPredicate(format: "identifier == %@", path)).allElementsBoundByAccessibilityElement
            let physical = rows.filter { row in
                // QA11's actual native TableRow returns no AXEnabled value.
                // A grouping row must have a genuine physical hit point; the
                // original Open button still requires its enabled state.
                guard row.exists else { return false }
                let frame = row.frame, hittable = row.isHittable
                print("PDFNO_NATIVE_PATH_ROW_CANDIDATE exact=true utf16=\(path.utf16.count) frame=\(frame) sheetFrame=\(bounds) hittable=\(hittable)")
                return hittable && !frame.isEmpty && !frame.isNull && !frame.isInfinite
                    && frame.minX.isFinite && frame.minY.isFinite
                    && !bounds.intersection(frame).isEmpty
            }
            guard physical.count == 1 else { return false }
            completion = physical[0]
            return true
        }, evaluatedWith: app)
        wait(for: [ready], timeout: 12)
        let row = try XCTUnwrap(completion, "The complete original fixture must have exactly one physical native completion row")
        XCTAssertEqual(row.elementType, .tableRow)
        let original = row.descendants(matching: .other).matching(NSPredicate(format: "identifier == %@", path)).firstMatch
        XCTAssertTrue(original.exists)
        XCTAssertEqual(original.identifier, path)
        print("PDFNO_NATIVE_PATH_COMPLETION exact=true utf16=\(path.utf16.count) rowFrame=\(row.frame) sheetFrame=\(sheet.frame) hittable=\(row.isHittable)")
        try shot("CH-10-native-original-path-completion", app)
        row.doubleClick()
        let closed = expectation(for: NSPredicate { _, _ in !sheet.exists }, evaluatedWith: app)
        wait(for: [closed], timeout: 12)
        XCTAssertFalse(sheet.exists, "The actual native completion action must close GoTo before the unchanged filename/Open assertions")
        print("PDFNO_ORIGINAL_GOTO_CONFIRM nativeCompletionDoubleClick=true closed=true")
    }


